<?xml version="1.0" encoding="utf-8"?>
<!-- Backs up shared preferences (session token fallback, offline cache) and
     app data to Google Drive on Android 11 and below. -->
<full-backup-content>
    <include domain="sharedpref" path="." />
    <include domain="database" path="." />
    <include domain="file" path="." />
</full-backup-content>
