<?xml version="1.0" encoding="utf-8"?>
<!-- Backs up shared preferences (session token fallback, offline cache) and
     app data on Android 12+, including device-to-device transfer so users
     stay logged in after restoring on a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
        <include domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
